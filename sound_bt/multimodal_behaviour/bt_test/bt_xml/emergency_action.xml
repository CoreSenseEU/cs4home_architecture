<?xml version="1.0"?>
<root main_tree_to_execute="BehaviorTree">
    <!-- ////////// -->
    <BehaviorTree ID="BehaviorTree">
        <Sequence>
            <RetryUntilSuccessful num_attempts="-1">
                <Condition ID="IsSoundDetected"/>
            </RetryUntilSuccessful>
            <RetryUntilSuccessful num_attempts="-1">
                <Sequence>
                    <Action ID="Rotate" angle="0.78" speed='0.3'/>
                    <Delay delay_msec="150">
                        <Action ID="IsHumanDetected"/>
                    </Delay>
                </Sequence>
            </RetryUntilSuccessful>
            <Action ID="Rotate" angle="-0.78" speed='0.3'/>
            <Action ID="Rotate" angle="-0.78" speed='0.3'/>
            <Action ID="Attend" interaction_type="emergency" event="" /> 
        </Sequence>
    </BehaviorTree>
    <!-- ////////// -->
    <TreeNodesModel>
        <Condition ID="IsSoundDetected">
            <output_port default="" name="sound_detected"/>
            <output_port default="0.0" name="target_angle"/>
        </Condition>
        <Condition ID="IsAudioLocated">
            <input_port default="0.0" name="target_angle"/>
            <output_port default="0.0" name="source_angle"/>
        </Condition>
        <Action ID="Rotate">
            <input_port default="0.0" name="angle"/>
            <input_port default="0.0" name="speed"/>
        </Action>
        <Action ID="IsHumanDetected">
        </Action>
        <Action ID="DefineInteraction">
            <input_port default="" name="event"/>
            <input_port default="false" name="human_detected"/>
            <output_port default="emergency" name="interaction_type"/>
        </Action>
        <Action ID="Attend">
            <input_port default="emergency" name="interaction_type"/>
            <input_port default="" name="event"/>
        </Action>
    </TreeNodesModel>
    <!-- ////////// -->
</root>
