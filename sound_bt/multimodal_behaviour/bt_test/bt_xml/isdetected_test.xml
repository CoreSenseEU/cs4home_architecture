<?xml version="1.0"?>
<root main_tree_to_execute="BehaviorTree">
    <!-- ////////// -->
    <BehaviorTree ID="BehaviorTree">
        <Sequence>
            <RetryUntilSuccessful num_attempts="-1">
                <Condition ID="IsSoundDetected" sound_detected="{sound}" target_angle="{target_angle}"/>
            </RetryUntilSuccessful>
            <RetryUntilSuccessful num_attempts="5">
                <Fallback>
                    <Condition ID="IsAudioLocated" target_angle="{target_angle}" source_angle="{angle}"/>
                    <Action ID="Rotate" angle="{angle}" speed='0.3'/>
                </Fallback>
            </RetryUntilSuccessful>
            <Fallback>
                <Sequence>
                    <Action ID="IsHumanDetected"/>
                    <Action ID="DefineInteraction" event="{sound}" human_detected="true" interaction_type="{interaction}" />
                </Sequence>
                <Sequence>
                    <RetryUntilSuccessful num_attempts="5">
                        <Sequence>
                            <Action ID="Rotate" angle="1.57" speed='0.3'/>
                            <Action ID="IsHumanDetected"/>
                        </Sequence>
                    </RetryUntilSuccessful>
                    <Action ID="DefineInteraction" event="{sound}" human_detected="false" interaction_type="{interaction}" />
                </Sequence>
            </Fallback>
            <Action ID="Attend" interaction_type="{interaction}" event="{sound}" />
        </Sequence>
    </BehaviorTree>
    <!-- ////////// -->
    <TreeNodesModel>
        <Condition ID="IsSoundDetected">
            <output_port default="" name="sound_detected"/>
            <output_port default="0.0" name="target_angle"/>
        </Condition>
        <Condition ID="IsAudioLocated">
            <input_port default="0.0" name="target_angle"/>
            <output_port default="0.0" name="source_angle"/>
        </Condition>
        <Action ID="Rotate">
            <input_port default="0.0" name="angle"/>
            <input_port default="0.0" name="speed"/>
        </Action>
        <Action ID="IsHumanDetected">
        </Action>
        <Action ID="DefineInteraction">
            <input_port default="" name="event"/>
            <input_port default="false" name="human_detected"/>
            <output_port default="emergency" name="interaction_type"/>
        </Action>
        <Action ID="Attend">
            <input_port default="emergency" name="interaction_type"/>
            <input_port default="" name="event"/>
        </Action>
    </TreeNodesModel>
    <!-- ////////// -->
</root>
